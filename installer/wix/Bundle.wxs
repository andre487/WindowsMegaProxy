<?xml version="1.0" encoding="utf-8"?>
<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
    xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
    <Bundle
        Name="MegaProxy"
        Manufacturer="MegaProxy"
        Version="$(var.AppVersion)"
        UpgradeCode="AE632890-306E-471C-A39D-8B97ED0B6583"
        IconSourceFile="$(var.RepositoryRoot)\src\WindowsMegaProxy\Assets\app.ico"
        AboutUrl="https://github.com/andre487/WindowsMegaProxy">
        <BootstrapperApplication>
            <bal:WixStandardBootstrapperApplication
                LicenseUrl="https://github.com/andre487/WindowsMegaProxy/blob/main/LICENSE"
                Theme="hyperlinkLargeLicense"
                ThemeFile="$(var.RepositoryRoot)\installer\wix\Theme.xml"
                LogoFile="$(var.RepositoryRoot)\src\WindowsMegaProxy\Assets\toolbar.png"
                ShowVersion="yes" />
        </BootstrapperApplication>
        <Variable Name="Mode" Type="string" Value="preserve" bal:Overridable="yes" />
        <Variable Name="WixStdBAScope" Type="string" Value="PerMachine" bal:Overridable="yes" />
        <Variable Name="AutomaticUpdates" Type="string" Value="preserve" bal:Overridable="yes" />
        <Variable Name="InstallSSH" Type="numeric" Value="1" bal:Overridable="yes" />
        <Variable Name="DesktopShortcut" Type="numeric" Value="0" bal:Overridable="yes" />
        <Variable Name="LaunchAfterSetup" Type="numeric" Value="0" bal:Overridable="yes" />
        <Variable Name="OwnerProfile" Type="formatted" Value="[LocalAppDataFolder]" />
        <netfx:DotNetCoreSearch Variable="DesktopRuntime" RuntimeType="desktop" Platform="x64" MajorVersion="10" />
        <bal:Condition
            Message="MegaProxy requires Windows 10 version 1809 or later (x64)."
            Condition="VersionNT64 AND WindowsBuildNumber &gt;= 17763" />
        <Chain>
            <ExePackage
                Id="DesktopRuntimePackage"
                SourceFile="$(var.RuntimeInstaller)"
                DownloadUrl="$(var.RuntimeURL)"
                Compressed="no"
                PerMachine="yes"
                Permanent="yes"
                DetectCondition="DesktopRuntime &gt;= v$(var.RuntimeVersion)"
                InstallArguments="/install /quiet /norestart">
                <ExitCode Value="3010" Behavior="scheduleReboot" />
            </ExePackage>
            <MsiPackage Id="RegistrationPackage" SourceFile="$(var.RegistrationPackage)" Compressed="yes" />
            <ExePackage
                Id="MegaProxyPackage"
                SourceFile="$(var.SetupDirectory)\WindowsMegaProxy.Setup.exe"
                PerMachine="yes"
                DetectCondition="WixBundleInstalled"
                InstallArguments="install [WixBundlePlannedScope] &quot;[OwnerProfile]&quot; [Mode] [AutomaticUpdates] [InstallSSH] [DesktopShortcut] [WixBundleAction] [LaunchAfterSetup]"
                RepairArguments="install [WixBundlePlannedScope] &quot;[OwnerProfile]&quot; [Mode] [AutomaticUpdates] [InstallSSH] [DesktopShortcut] [WixBundleAction] [LaunchAfterSetup]"
                UninstallArguments="remove [WixBundlePlannedScope] &quot;[OwnerProfile]&quot; preserve preserve 0 0 [WixBundleAction] 0">
                <Payload SourceFile="$(var.SetupDirectory)\WindowsMegaProxy.Setup.dll" />
                <Payload SourceFile="$(var.SetupDirectory)\WindowsMegaProxy.Setup.deps.json" />
                <Payload SourceFile="$(var.SetupDirectory)\WindowsMegaProxy.Setup.runtimeconfig.json" />
            </ExePackage>
        </Chain>
    </Bundle>
</Wix>
