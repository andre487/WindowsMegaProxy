<?xml version="1.0" encoding="utf-8"?>
<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Bundle
        Name="MegaProxy"
        Manufacturer="MegaProxy"
        Version="$(var.AppVersion)"
        UpgradeCode="AE632890-306E-471C-A39D-8B97ED0B6583"
        IconSourceFile="$(var.RepositoryRoot)\src\WindowsMegaProxy\Assets\app.ico"
        AboutUrl="https://github.com/andre487/WindowsMegaProxy">
        <BootstrapperApplication SourceFile="$(var.UIDirectory)\WindowsMegaProxy.SetupUI.exe">
            <Payload SourceFile="$(var.UIDirectory)\WindowsMegaProxy.SetupUI.exe.config" />
            <Payload SourceFile="$(var.UIDirectory)\WixToolset.BootstrapperApplicationApi.dll" />
            <Payload SourceFile="$(var.UIDirectory)\mbanative.dll" />
            <Payload Id="BootSetup" SourceFile="$(var.SetupDirectory)\WindowsMegaProxy.Setup.exe" />
            <Payload SourceFile="$(var.ResourceDirectory)\payload.zip" />
        </BootstrapperApplication>
        <Variable Name="SetupPayloadPath" Type="string" Value="" />
        <Variable Name="SetupAction" Type="string" Value="install" />
        <Variable Name="Mode" Type="string" Value="preserve" />
        <Variable Name="AutomaticUpdates" Type="string" Value="preserve" />
        <Variable Name="StagedUpdate" Type="string" Value="0" />
        <Variable Name="SetupEngineSha256" Type="string" Value="$(var.SetupEngineSha256)" />
        <Variable Name="DesktopShortcut" Type="numeric" Value="0" />
        <Variable Name="LaunchAfterSetup" Type="numeric" Value="0" />
        <Variable Name="IsUninstall" Type="numeric" Value="0" />
        <Variable Name="RemovalAction" Type="string" Value="remove" />
        <Variable Name="OwnerSid" Type="string" Value="" Hidden="yes" />
        <Chain>
            <MsiPackage Id="RegistrationPackage" SourceFile="$(var.RegistrationPackage)" Compressed="yes" />
            <ExePackage
                Id="MegaProxyPackage"
                CacheId="MegaProxy.$(var.SetupBuildId)"
                InstallSize="$(var.InstallSize)"
                SourceFile="$(var.SetupDirectory)\WindowsMegaProxy.Setup.exe"
                PerMachine="yes"
                DetectCondition="WixBundleInstalled"
                InstallArguments="[SetupAction] [WixBundlePlannedScope] &quot;[OwnerSid]&quot; [Mode] [AutomaticUpdates] 1 [DesktopShortcut] [IsUninstall] [LaunchAfterSetup] [StagedUpdate] &quot;[SetupPayloadPath]&quot;"
                RepairArguments="[SetupAction] [WixBundlePlannedScope] &quot;[OwnerSid]&quot; [Mode] [AutomaticUpdates] 1 [DesktopShortcut] [IsUninstall] [LaunchAfterSetup] [StagedUpdate] &quot;[SetupPayloadPath]&quot;"
                UninstallArguments="[RemovalAction] [WixBundlePlannedScope] &quot;[OwnerSid]&quot; preserve preserve 1 0 [IsUninstall] 0 0 &quot;[SetupPayloadPath]&quot;">
                <Payload SourceFile="$(var.SetupDirectory)\WindowsMegaProxy.Setup.exe.config" />
            </ExePackage>
        </Chain>
    </Bundle>
</Wix>
