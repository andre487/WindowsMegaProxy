<?xml version="1.0" encoding="utf-8"?>
<!-- Adapted WiX strings: .NET Foundation and contributors, MS-RL. -->
<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Culture="ru-ru" Language="1049">
    <String Id="UninstallPrompt" Value="Удалить MegaProxy с этого компьютера? Ваша конфигурация сохранится." />
    <String Id="InstallHeader" Value="Добро пожаловать" />
    <String Id="ConfirmCancelMessage" Value="Отмена: дождитесь завершения текущей операции..." />
    <String Id="HelpText" Value="/install | /repair | /uninstall — установка, восстановление или удаление.&#10;Scope=PerMachine | Scope=PerUser — для всех пользователей или текущего пользователя.&#10;/passive | /quiet — минимальный интерфейс или установка без интерфейса.&#10;/norestart — без перезагрузки.&#10;/log файл.log — сохранить журнал.&#10;Mode=manual|login|service — режим работы.&#10;InstallSSH=0 — не устанавливать OpenSSH.&#10;AutomaticUpdates=false — отключить автоматические обновления." />
    <String Id="InstallInstallButton" Value="Установить" />
    <String Id="InstallCancelButton" Value="Отмена" />
    <String Id="ProgressHeader" Value="Ход установки" />
    <String Id="OverallProgressPackageText" Value="Подготовка…" />
    <String Id="ModifyRepairButton" Value="Восстановить" />
    <String Id="ModifyUninstallButton" Value="Удалить" />
    <String Id="SuccessHeader" Value="Готово" />
    <String Id="SuccessRestartText" Value="Перед использованием приложения необходимо перезагрузить компьютер." />
    <String Id="SuccessCloseButton" Value="Готово" />
    <String Id="FailureHeader" Value="Ошибка установки" />
    <String Id="SetupOptions" Value="Область установки" />
    <String Id="ScopeLocked" Value="Чтобы изменить область установки, сначала удалите MegaProxy. Конфигурация сохраняется." />
    <String Id="LicenseLink" Value="Лицензия" />
    <String Id="SetupLog" Value="Журнал установки" />
    <String Id="SystemScope" Value="Для всех пользователей" />
    <String Id="PersonalScope" Value="Только для меня" />
    <String Id="OperatingMode" Value="Режим работы" />
    <String Id="PreserveMode" Value="Оставить текущий режим" />
    <String Id="ManualMode" Value="Ручной запуск" />
    <String Id="LoginMode" Value="При входе в Windows (администратор)" />
    <String Id="ServiceMode" Value="Служба Windows" />
    <String Id="AutomaticUpdates" Value="Автоматическое обновление приложения" />
    <String Id="PreserveUpdates" Value="Оставить текущую настройку" />
    <String Id="EnableUpdates" Value="Проверять автоматически" />
    <String Id="DisableUpdates" Value="Отключить автоматические обновления" />
    <String Id="DesktopShortcut" Value="Создать ярлык на рабочем столе" />
    <String Id="LaunchAfterSetup" Value="Запустить MegaProxy после установки" />
    <String Id="StepTitle" Value="Шаг {0} из 3 — {1}" />
    <String Id="NextButton" Value="&amp;Далее" />
    <String Id="BackButton" Value="&amp;Назад" />
    <String Id="SystemScopeDescription" Value="Общая конфигурация для этого компьютера. Менять настройки могут администраторы. Доступен запуск в виде службы Windows." />
    <String Id="PersonalScopeDescription" Value="Личная конфигурация и ярлыки. При установке потребуется подтверждение администратора. Режим службы Windows недоступен." />
    <String Id="PreserveModeDescription" Value="Существующая установка сохранит режим запуска. При первой установке будет выбран ручной запуск." />
    <String Id="ManualModeDescription" Value="Запускайте MegaProxy, когда он нужен. Трафик перенаправляется только при активном подключении приложения." />
    <String Id="LoginModeDescription" Value="MegaProxy запускается в трее при входе в Windows. Установщик подготовит запуск с необходимыми повышенными правами." />
    <String Id="ServiceModeDescription" Value="Сетевая служба запускается вместе с Windows, до входа пользователя, и работает независимо от окна. Клиент в трее запускается при входе." />
    <String Id="PreserveUpdatesDescription" Value="Сохранить существующую настройку. При первой установке MegaProxy будет проверять обновления раз в день." />
    <String Id="EnableUpdatesDescription" Value="Проверять раз в день и уведомлять о новой версии. Время скачивания и установки выбираете вы." />
    <String Id="DisableUpdatesDescription" Value="Не проверять обновления в фоне. Проверку можно запустить вручную в настройках." />
    <String Id="InnoInstallationDetected" Value="Обнаружена старая установка Inno Setup. Экспортируйте конфигурацию, удалите старую версию в параметрах Windows, затем запустите установщик снова." />
    <String Id="KeepData" Value="Удалить приложение, сохранив данные" />
    <String Id="KeepDataDescription" Value="Удалить приложение и записи автозапуска. Сохранить профили, правила и настройки для последующей установки." />
    <String Id="RemoveData" Value="Удалить приложение и данные" />
    <String Id="RemoveDataDescription" Value="Также безвозвратно удалить профили, правила, настройки, журналы и кеши этой области установки. При необходимости сначала экспортируйте конфигурацию. Личные установки других пользователей и данные DEV не удаляются." />
</WixLocalization>
