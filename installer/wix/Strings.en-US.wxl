<?xml version="1.0" encoding="utf-8"?>
<!-- Adapted WiX strings: .NET Foundation and contributors, MS-RL. -->
<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Culture="en-us" Language="1033">
    <String Id="UninstallPrompt" Value="Remove MegaProxy from this computer? Your configuration will be retained." />
    <String Id="InstallHeader" Value="Welcome" />
    <String Id="ConfirmCancelMessage" Value="Cancelling; waiting for the current operation to finish..." />
    <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - installs, repairs, uninstalls or&#10;   creates a complete local copy of the bundle in directory. Install is the default. Scope=PerMachine|PerUser selects the installation scope.&#10;&#10;/passive | /quiet -  displays minimal UI with no prompts or displays no UI and&#10;   no prompts. By default UI and all prompts are displayed.&#10;&#10;/norestart   - suppress any attempts to restart. By default UI will prompt before restart.&#10;/log log.txt - logs to a specific file. By default a log file is created in %TEMP%." />
    <String Id="InstallInstallButton" Value="&amp;Install" />
    <String Id="InstallCancelButton" Value="&amp;Cancel" />
    <String Id="ProgressHeader" Value="Setup Progress" />
    <String Id="OverallProgressPackageText" Value="Initializing..." />
    <String Id="ModifyRepairButton" Value="&amp;Repair" />
    <String Id="ModifyUninstallButton" Value="&amp;Uninstall" />
    <String Id="SuccessHeader" Value="Setup Successful" />
    <String Id="SuccessRestartText" Value="You must restart your computer before you can use the software." />
    <String Id="SuccessCloseButton" Value="&amp;Close" />
    <String Id="FailureHeader" Value="Setup Failed" />
    <String Id="SetupOptions" Value="Installation scope" />
    <String Id="ScopeLocked" Value="To change installation scope, uninstall MegaProxy first. Configuration is retained." />
    <String Id="LicenseLink" Value="License" />
    <String Id="SetupLog" Value="Setup log" />
    <String Id="SystemScope" Value="All users" />
    <String Id="PersonalScope" Value="Only me" />
    <String Id="OperatingMode" Value="Operating mode" />
    <String Id="PreserveMode" Value="Keep current mode" />
    <String Id="ManualMode" Value="Manual launch" />
    <String Id="LoginMode" Value="At Windows sign-in (administrator)" />
    <String Id="ServiceMode" Value="Windows service" />
    <String Id="AutomaticUpdates" Value="Automatic application updates" />
    <String Id="PreserveUpdates" Value="Keep current preference" />
    <String Id="EnableUpdates" Value="Check automatically" />
    <String Id="DisableUpdates" Value="Disable automatic updates" />
    <String Id="DesktopShortcut" Value="Create a desktop shortcut" />
    <String Id="LaunchAfterSetup" Value="Launch MegaProxy after installation" />
    <String Id="StepTitle" Value="Step {0} of 3 — {1}" />
    <String Id="NextButton" Value="&amp;Next" />
    <String Id="BackButton" Value="&amp;Back" />
    <String Id="SystemScopeDescription" Value="One shared configuration for this computer. Administrators can change settings. Supports running as a Windows service." />
    <String Id="PersonalScopeDescription" Value="Your own configuration and shortcuts. An administrator approves setup once. Windows service mode is unavailable." />
    <String Id="PreserveModeDescription" Value="An existing installation keeps its startup mode. A new installation uses manual launch." />
    <String Id="ManualModeDescription" Value="Start MegaProxy when you need it. Traffic is redirected only while the application is connected." />
    <String Id="LoginModeDescription" Value="MegaProxy starts in the tray when you sign in to Windows. Setup prepares the required elevated launch." />
    <String Id="ServiceModeDescription" Value="The network service starts with Windows, before sign-in, and works independently of the window. The tray client opens at sign-in." />
    <String Id="PreserveUpdatesDescription" Value="Keep your existing preference. On a new installation, MegaProxy checks for updates once a day." />
    <String Id="EnableUpdatesDescription" Value="Check once a day and notify you when an update is available. You choose when to download and install it." />
    <String Id="DisableUpdatesDescription" Value="Do not check in the background. You can check for updates manually in Settings." />
    <String Id="InnoInstallationDetected" Value="An older Inno Setup installation was found. Export your configuration, uninstall the old version in Windows Settings, then run this installer again." />
</WixLocalization>
