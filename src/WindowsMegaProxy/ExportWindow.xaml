<?xml version="1.0" encoding="utf-8"?>
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WindowsMegaProxy"
    x:Class="WindowsMegaProxy.ExportWindow"
    Title="{DynamicResource &quot;Export configuration&quot;}"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    FontFamily="Segoe UI Variable, Segoe UI"
    FontWeight="Normal"
    FontSize="14">
    <StackPanel Margin="24">
        <TextBlock
            Text="{DynamicResource &quot;Profiles and client settings&quot;}"
            Style="{DynamicResource SubtitleTextBlockStyle}"
            Margin="0,0,0,16" />
        <CheckBox
            x:Name="PasswordsBox"
            Content="{DynamicResource &quot;Include passwords&quot;}"
            Margin="0,0,0,16" />
        <Label
            x:Name="FormatLabel"
            Content="{DynamicResource &quot;Format&quot;}"
            Target="{Binding ElementName=FormatBox}"
            Padding="0"
            Margin="0,0,0,4" />
        <ComboBox
            x:Name="FormatBox"
            AutomationProperties.Name="{DynamicResource &quot;Format&quot;}"
            AutomationProperties.LabeledBy="{Binding ElementName=FormatLabel}"
            SelectedIndex="0"
            Margin="0,0,0,16">
            <ComboBoxItem Content="MegaProxy JSON" />
            <ComboBoxItem Content="ProxyList (HTTPS, MASQUE, SOCKS5)" />
        </ComboBox>
        <CheckBox
            x:Name="PrivateKeysBox"
            Content="{DynamicResource &quot;Include private SSH keys&quot;}"
            Margin="0,0,0,16" />
        <TextBlock
            Text="{DynamicResource &quot;The file is not encrypted. Subscription URLs and extra fields may contain tokens even without passwords. Share it only with trusted recipients.&quot;}"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button
                Content="{DynamicResource &quot;Export&quot;}"
                Click="ExportClick"
                IsDefault="True"
                Margin="0,0,8,0" />
            <Button Content="{DynamicResource &quot;Cancel&quot;}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
