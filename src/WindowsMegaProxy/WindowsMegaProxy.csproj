<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- WPF owns startup; WinForms is used only for NotifyIcon. DPI is set by the process manifest. -->
        <NoWarn>$(NoWarn);WFO0003</NoWarn>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="../../assets/strings.json" LogicalName="WindowsMegaProxy.Strings.json" />
        <Resource Include="Assets/*.ico" />
        <Resource Include="Assets/Flags/*.png" />
        <EmbeddedResource
            Include="../../assets/profile-colors.json"
            LogicalName="WindowsMegaProxy.ProfileColors.json" />
        <EmbeddedResource
            Include="../../assets/flags/countries.json"
            LogicalName="WindowsMegaProxy.Countries.json" />
        <Content
            Include="../../assets/flags/LICENSE"
            Link="Notices/flag-icons-LICENSE.txt"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
