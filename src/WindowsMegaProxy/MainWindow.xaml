<?xml version="1.0" encoding="utf-8"?>
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WindowsMegaProxy"
    xmlns:core="clr-namespace:WindowsMegaProxy;assembly=WindowsMegaProxy.Core"
    x:Class="WindowsMegaProxy.MainWindow"
    Title="MegaProxy"
    Width="1100"
    Height="740"
    MinWidth="820"
    MinHeight="590"
    Icon="Assets/app.ico"
    FontFamily="Segoe UI Variable, Segoe UI"
    FontSize="14"
    FontWeight="Normal"
    UseLayoutRounding="True"
    Closing="WindowClosing"
    Loaded="WindowLoaded">
    <Window.Resources>
        <Style x:Key="DiagnosticCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="DiagnosticValueStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
            <Setter Property="ClipboardCopyMode" Value="ExcludeHeader" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="CanUserDeleteRows" Value="False" />
        </Style>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="CountryFlagStyle" TargetType="Image">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FlagUri}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ProfilePickerTemplate">
            <StackPanel Orientation="Horizontal">
                <Border
                    Background="{Binding ColorHex}"
                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    BorderThickness="1"
                    Width="10"
                    Height="10"
                    CornerRadius="5"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center" />
                <Image
                    Source="{Binding FlagUri}"
                    Style="{StaticResource CountryFlagStyle}"
                    ToolTip="{Binding CountryName}"
                    AutomationProperties.Name="{Binding CountryName}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock
                    Text="{Binding Type}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SectionHeaderStyle" TargetType="TabItem">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border
                                x:Name="HeaderBackground"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Border
                                x:Name="SelectionIndicator"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Height="3"
                                Width="24"
                                CornerRadius="1.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="HeaderBackground"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    Property="Foreground"
                                    Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="MegaProxy"
                Style="{DynamicResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />
            <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center">
                <MenuItem
                    AutomationProperties.Name="{DynamicResource &quot;Application actions&quot;}"
                    ToolTip="{DynamicResource &quot;Application actions&quot;}"
                    Padding="12,8">
                    <MenuItem.Header>
                        <TextBlock
                            Text="&#xE712;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="16" />
                    </MenuItem.Header>
                    <MenuItem
                        Header="{DynamicResource &quot;_Import MegaProxy.json…&quot;}"
                        Click="ImportClick" />
                    <MenuItem
                        Header="{DynamicResource &quot;_Export MegaProxy.json…&quot;}"
                        Click="ExportClick" />
                    <Separator />
                    <MenuItem Header="{DynamicResource &quot;Minimize to _tray&quot;}" Click="HideClick" />
                    <Separator />
                    <MenuItem Header="{DynamicResource &quot;E_xit&quot;}" Click="QuitClick" />
                </MenuItem>
            </Menu>
        </Grid>
        <Border
            Grid.Row="1"
            Padding="20,16"
            Margin="0,0,0,16"
            CornerRadius="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock
                        Text="{DynamicResource &quot;Connection&quot;}"
                        Style="{DynamicResource CaptionTextBlockStyle}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="StatusText"
                        Text="{DynamicResource &quot;Disconnected&quot;}"
                        Style="{DynamicResource SubtitleTextBlockStyle}"
                        Margin="0,4,0,4"
                        AutomationProperties.LiveSetting="Polite" />
                    <ComboBox
                        x:Name="ProfilePicker"
                        ItemTemplate="{StaticResource ProfilePickerTemplate}"
                        SelectionChanged="ProfileSelectionChanged"
                        MinWidth="240"
                        MaxWidth="420"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,8"
                        AutomationProperties.Name="{DynamicResource &quot;Active profile&quot;}" />
                    <TextBlock
                        x:Name="ProfileSummary"
                        Text="{DynamicResource &quot;No proxy configured&quot;}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Width="172" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button
                        x:Name="ConnectButton"
                        Click="ConnectClick"
                        Content="{DynamicResource &quot;Connect&quot;}"
                        Style="{DynamicResource AccentButtonStyle}"
                        MinWidth="120"
                        MinHeight="32"
                        Padding="12,4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="ReconnectButton"
                        HorizontalAlignment="Stretch"
                        Content="{DynamicResource &quot;Reconnect&quot;}"
                        Click="ReconnectClick"
                        Margin="0,8,0,0"
                        IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
        <TabControl
            x:Name="Sections"
            Grid.Row="2"
            ItemContainerStyle="{StaticResource SectionHeaderStyle}"
            AutomationProperties.Name="{DynamicResource &quot;Application sections&quot;}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel IsItemsHost="True" Margin="0,0,0,12" KeyboardNavigation.TabIndex="1" />
                        <Border
                            Grid.Row="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                ContentSource="SelectedContent"
                                Margin="20" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="{DynamicResource &quot;Connections&quot;}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox
                            x:Name="ShowAllConnectionsBox"
                            Content="{DynamicResource &quot;Show all&quot;}"
                            Click="ShowAllConnectionsClick"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0" />
                        <TextBlock x:Name="TrafficText" Text="↑ —  ↓ —" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock
                            x:Name="ConnectionsHint"
                            Text="{DynamicResource &quot;Connect to view traffic. Only rule exceptions are shown by default.&quot;}"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0" />
                    </StackPanel>
                    <DataGrid
                        x:Name="ConnectionsGrid"
                        VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        AutomationProperties.Name="{DynamicResource &quot;Active connections&quot;}"
                        EnableRowVirtualization="True">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            Padding="12,6"
                                            Margin="0,8,0,0">
                                            <TextBlock FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style
                                                        TargetType="TextBlock"
                                                        BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter
                                                            Property="Text"
                                                            Value="{DynamicResource &quot;System mode&quot;}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="0">
                                                                <Setter
                                                                    Property="Text"
                                                                    Value="{DynamicResource &quot;Active profile&quot;}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="1">
                                                                <Setter
                                                                    Property="Text"
                                                                    Value="{DynamicResource &quot;Blocked&quot;}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Background" Value="#04808080" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RouteGroup}" Value="0">
                                        <Setter Property="Background" Value="#0C0078D4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RouteGroup}" Value="1">
                                        <Setter Property="Background" Value="#10EAA300" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                ClipboardContentBinding="{Binding Process}"
                                SortMemberPath="Process"
                                Width="2*"
                                Header="{Binding [Application], Source={x:Static core:Ui.Strings}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:PathTextBox FullPath="{Binding Process}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Binding="{Binding Destination}"
                                Width="2*"
                                Header="{Binding [Destination], Source={x:Static core:Ui.Strings}}" />
                            <DataGridTextColumn
                                Binding="{Binding Network}"
                                Width="95"
                                Header="{Binding [Protocol], Source={x:Static core:Ui.Strings}}" />
                            <DataGridTextColumn
                                Binding="{Binding Route}"
                                Width="*"
                                Header="{Binding [Route], Source={x:Static core:Ui.Strings}}" />
                            <DataGridTextColumn
                                Binding="{Binding Upload}"
                                SortMemberPath="UploadedBytes"
                                Width="105"
                                Header="{Binding [Uploaded], Source={x:Static core:Ui.Strings}}" />
                            <DataGridTextColumn
                                Binding="{Binding Download}"
                                SortMemberPath="DownloadedBytes"
                                Width="105"
                                Header="{Binding [Downloaded], Source={x:Static core:Ui.Strings}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource &quot;Profiles&quot;}">
                <Grid x:Name="ProfilePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="{DynamicResource &quot;Connection profiles&quot;}"
                        Style="{DynamicResource SubtitleTextBlockStyle}"
                        Margin="0,0,0,16" />
                    <ListBox
                        x:Name="ProfilesList"
                        Grid.Row="1"
                        AutomationProperties.Name="{DynamicResource &quot;Connection profiles&quot;}"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Background="{Binding ColorHex}"
                                        CornerRadius="2"
                                        BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                        BorderThickness="0.5" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                Source="{Binding FlagUri}"
                                                Style="{StaticResource CountryFlagStyle}"
                                                ToolTip="{Binding CountryName}"
                                                AutomationProperties.Name="{Binding CountryName}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding Description}"
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{Binding Availability}"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button
                            Content="{DynamicResource &quot;Add&quot;}"
                            Click="AddProfileClick"
                            Margin="0,0,8,8" />
                        <Button
                            Content="{DynamicResource &quot;Edit&quot;}"
                            Click="EditProfileClick"
                            Margin="0,0,8,8" />
                        <Button
                            Content="{DynamicResource &quot;Duplicate&quot;}"
                            Click="CloneProfileClick"
                            Margin="0,0,8,8" />
                        <Button
                            Content="{DynamicResource &quot;Delete&quot;}"
                            Click="DeleteProfileClick"
                            Margin="0,0,8,8" />
                        <Button
                            Content="{DynamicResource &quot;Import…&quot;}"
                            Click="ImportClick"
                            Margin="0,0,8,8" />
                        <Button
                            Content="{DynamicResource &quot;Export…&quot;}"
                            Click="ExportClick"
                            Margin="0,0,0,8" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource &quot;Rules&quot;}">
                <Grid x:Name="RulesPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock
                            Text="{DynamicResource &quot;Default action:&quot;}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                        <ComboBox
                            x:Name="DefaultActionBox"
                            Width="160"
                            AutomationProperties.Name="{DynamicResource &quot;Default action&quot;}"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{DynamicResource &quot;Active profile&quot;}" Tag="proxy" />
                            <ComboBoxItem Content="{DynamicResource &quot;System mode&quot;}" Tag="system" />
                            <ComboBoxItem Content="{DynamicResource &quot;Block&quot;}" Tag="block" />
                        </ComboBox>
                        <CheckBox
                            x:Name="BypassLanBox"
                            Content="{DynamicResource &quot;Bypass local networks&quot;}"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Text="{DynamicResource &quot;Rules run from top to bottom; the first match selects the route. LAN bypass follows the list. Reconnect to apply changes.&quot;}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12" />
                    <DataGrid
                        x:Name="RulesList"
                        MouseDoubleClick="RulesDoubleClick"
                        PreviewKeyDown="RulesKeyDown"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        SelectionUnit="FullRow"
                        AutomationProperties.Name="{DynamicResource &quot;Routing rules in priority order&quot;}"
                        Grid.Row="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Width="2*"
                                ClipboardContentBinding="{Binding SourceLabel}"
                                Header="{Binding [Application], Source={x:Static core:Ui.Strings}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:PathTextBox FullPath="{Binding SourceLabel}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding DestinationLabel}"
                                Header="{Binding [Destination], Source={x:Static core:Ui.Strings}}" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ActionLabel}"
                                Header="{Binding [Action], Source={x:Static core:Ui.Strings}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button
                            Content="{DynamicResource &quot;Add&quot;}"
                            Margin="0,0,8,0"
                            Click="AddRuleClick" />
                        <Button
                            Content="{DynamicResource &quot;Edit&quot;}"
                            Margin="0,0,8,0"
                            Click="EditRuleClick" />
                        <Button
                            Content="{DynamicResource &quot;Delete&quot;}"
                            Margin="0,0,8,0"
                            Click="DeleteRuleClick" />
                        <Button
                            Content="↑"
                            AutomationProperties.Name="{DynamicResource &quot;Move rule up&quot;}"
                            Margin="0,0,8,0"
                            Click="MoveRuleUpClick" />
                        <Button
                            Content="↓"
                            AutomationProperties.Name="{DynamicResource &quot;Move rule down&quot;}"
                            Margin="0,0,8,0"
                            Click="MoveRuleDownClick" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource &quot;Settings&quot;}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <Button
                            x:Name="InstallServiceButton"
                            Content="{DynamicResource &quot;Install service…&quot;}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16"
                            Visibility="Collapsed"
                            Click="InstallServiceClick" />
                        <TextBlock
                            Text="{DynamicResource &quot;Appearance&quot;}"
                            Style="{DynamicResource SubtitleTextBlockStyle}"
                            Margin="0,0,0,16" />
                        <WrapPanel Margin="0,0,0,24">
                            <StackPanel Width="180" Margin="0,0,16,0">
                                <Label
                                    Content="{DynamicResource &quot;Language&quot;}"
                                    Target="{Binding ElementName=LanguageBox}"
                                    Padding="0"
                                    Margin="0,0,0,4" />
                                <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Русский" Tag="ru" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="180">
                                <Label
                                    Content="{DynamicResource &quot;Theme&quot;}"
                                    Target="{Binding ElementName=ThemeBox}"
                                    Padding="0"
                                    Margin="0,0,0,4" />
                                <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch">
                                    <ComboBoxItem
                                        Content="{DynamicResource &quot;Automatic&quot;}"
                                        Tag="auto" />
                                    <ComboBoxItem Content="{DynamicResource &quot;Light&quot;}" Tag="light" />
                                    <ComboBoxItem Content="{DynamicResource &quot;Dark&quot;}" Tag="dark" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                        <Label
                            Content="{DynamicResource &quot;TCP TLS fingerprint&quot;}"
                            Target="{Binding ElementName=TlsFingerprintBox}"
                            Padding="0"
                            Margin="0,0,0,4" />
                        <ComboBox
                            x:Name="TlsFingerprintBox"
                            HorizontalAlignment="Left"
                            Width="220"
                            Margin="0,0,0,12">
                            <ComboBoxItem Content="{DynamicResource &quot;Native TLS&quot;}" Tag="default" />
                            <ComboBoxItem Content="Chrome" Tag="chrome" />
                            <ComboBoxItem Content="Firefox" Tag="firefox" />
                            <ComboBoxItem Content="Edge" Tag="edge" />
                            <ComboBoxItem Content="Safari" Tag="safari" />
                            <ComboBoxItem Content="iOS" Tag="ios" />
                            <ComboBoxItem Content="Android" Tag="android" />
                            <ComboBoxItem Content="{DynamicResource &quot;Randomized&quot;}" Tag="randomized" />
                        </ComboBox>
                        <TextBlock Text="{DynamicResource &quot;HTTP/3 fingerprint&quot;}" Margin="0,0,0,4" />
                        <TextBlock Text="Native sing-box QUIC" Margin="0,0,0,4" />
                        <TextBlock
                            Text="{DynamicResource &quot;Browser fingerprints apply to HTTPS over TCP. HTTP/3 uses the native QUIC fingerprint; browser QUIC presets are unavailable in this core.&quot;}"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0,0,0,20" />
                        <TextBlock
                            Text="{DynamicResource &quot;Application startup&quot;}"
                            Style="{DynamicResource SubtitleTextBlockStyle}"
                            Margin="0,0,0,16" />
                        <CheckBox
                            x:Name="AutostartBox"
                            Content="{DynamicResource &quot;Start in the system tray when signing in to Windows&quot;}"
                            Margin="0,0,0,16" />
                        <CheckBox
                            x:Name="AutoConnectBox"
                            Content="{DynamicResource &quot;Connect when the application starts&quot;}"
                            Margin="0,0,0,16" />
                        <TextBlock
                            Text="{DynamicResource &quot;Log&quot;}"
                            Style="{DynamicResource SubtitleTextBlockStyle}"
                            Margin="0,8,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Label
                                Content="{DynamicResource &quot;Total size, MiB:&quot;}"
                                Target="{Binding ElementName=LogSizeBox}"
                                Padding="0"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0" />
                            <ComboBox
                                x:Name="LogSizeBox"
                                Width="100"
                                IsEditable="True"
                                IsTextSearchEnabled="False"
                                AutomationProperties.Name="{DynamicResource &quot;Log size in MiB&quot;}"
                                LostKeyboardFocus="LogSizeChanged"
                                KeyDown="LogSizeKeyDown">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="25" />
                                <ComboBoxItem Content="50" />
                                <ComboBoxItem Content="100" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="DiagnosticsTab" Header="{DynamicResource &quot;Diagnostics&quot;}">
                <ScrollViewer
                    x:Name="DiagnosticsScroll"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="DiagnosticResultCard" Style="{StaticResource DiagnosticCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{DynamicResource &quot;Connection&quot;}"
                                            Style="{DynamicResource SubtitleTextBlockStyle}" />
                                        <TextBlock
                                            x:Name="TestStatusText"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                            Text="{DynamicResource &quot;Ready to test&quot;}"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Margin="0,4,0,0"
                                            AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <Button
                                        x:Name="TestConnectionButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource &quot;Run again&quot;}"
                                        Click="TestConnectionClick"
                                        MinWidth="120"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar
                                    x:Name="TestProgress"
                                    IsIndeterminate="True"
                                    Visibility="Collapsed"
                                    Height="4"
                                    Margin="0,0,0,12" />
                                <TextBox
                                    x:Name="TestResultText"
                                    Style="{StaticResource DiagnosticValueStyle}"
                                    Text="{DynamicResource &quot;Testing starts automatically when this tab opens.&quot;}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid x:Name="DiagnosticDetailsPanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Text="{DynamicResource &quot;Public IP&quot;}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,8" />
                                    <TextBox
                                        x:Name="DiagnosticIpText"
                                        Grid.Column="1"
                                        Style="{StaticResource DiagnosticValueStyle}"
                                        Margin="0,0,0,8"
                                        AutomationProperties.Name="{DynamicResource &quot;Public IP&quot;}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{DynamicResource &quot;Country&quot;}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,8" />
                                    <StackPanel
                                        x:Name="DiagnosticCountryPanel"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,8">
                                        <Image
                                            Source="{Binding FlagUri}"
                                            Style="{StaticResource CountryFlagStyle}"
                                            AutomationProperties.Name="{Binding Label}" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="{DynamicResource &quot;HTTPS response&quot;}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Margin="0,0,16,8" />
                                    <TextBlock
                                        x:Name="DiagnosticLatencyText"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,0,0,8" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Text="HTTP/3"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Margin="0,0,16,0" />
                                    <TextBlock
                                        x:Name="DiagnosticHttp3Text"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DiagnosticSpeedCard" Style="{StaticResource DiagnosticCardStyle}">
                            <StackPanel>
                                <TextBlock
                                    Text="{DynamicResource &quot;Transfer speed&quot;}"
                                    Style="{DynamicResource SubtitleTextBlockStyle}"
                                    Margin="0,0,0,12" />
                                <TextBlock
                                    x:Name="SpeedLockedText"
                                    Text="{DynamicResource &quot;Complete a successful connection test first.&quot;}"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="SpeedPanel" Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="SpeedTrafficText"
                                        Text="{DynamicResource &quot;Cloudflare: 10 MB download and upload per route, up to 40 MB of traffic.&quot;}"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel x:Name="SpeedOptionsPanel">
                                            <StackPanel Width="144" Margin="0,0,16,12">
                                                <Label
                                                    Content="{DynamicResource &quot;Size per route&quot;}"
                                                    Target="{Binding ElementName=SpeedSizeBox}"
                                                    Padding="0"
                                                    Margin="0,0,0,4" />
                                                <ComboBox
                                                    x:Name="SpeedSizeBox"
                                                    SelectedIndex="0"
                                                    SelectionChanged="SpeedSizeChanged"
                                                    HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="{DynamicResource &quot;Speed test size&quot;}">
                                                    <ComboBoxItem
                                                        Content="{DynamicResource &quot;10 MB&quot;}"
                                                        Tag="10" />
                                                    <ComboBoxItem
                                                        Content="{DynamicResource &quot;25 MB&quot;}"
                                                        Tag="25" />
                                                    <ComboBoxItem
                                                        Content="{DynamicResource &quot;50 MB&quot;}"
                                                        Tag="50" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Width="144" Margin="0,0,16,12">
                                                <Label
                                                    Content="{DynamicResource &quot;HTTP preference&quot;}"
                                                    Target="{Binding ElementName=SpeedProtocolBox}"
                                                    Padding="0"
                                                    Margin="0,0,0,4" />
                                                <ComboBox
                                                    x:Name="SpeedProtocolBox"
                                                    SelectedIndex="1"
                                                    HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="{DynamicResource &quot;Preferred speed test protocol&quot;}">
                                                    <ComboBoxItem Content="HTTP/3" Tag="h3" />
                                                    <ComboBoxItem Content="HTTP/2" Tag="h2" />
                                                    <ComboBoxItem Content="HTTP/1.1" Tag="h1" />
                                                </ComboBox>
                                            </StackPanel>
                                        </WrapPanel>
                                        <Button
                                            x:Name="SpeedTestButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource &quot;Test speed&quot;}"
                                            Click="SpeedTestClick"
                                            MinWidth="144"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,12" />
                                    </Grid>
                                    <DataGrid
                                        x:Name="SpeedResultsGrid"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        IsReadOnly="True"
                                        Height="240"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="{DynamicResource &quot;Route speed comparison&quot;}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Binding="{Binding Metric}"
                                                Width="*"
                                                Header="{Binding [Metric], Source={x:Static core:Ui.Strings}}" />
                                            <DataGridTemplateColumn
                                                ClipboardContentBinding="{Binding Direct}"
                                                Width="2*"
                                                Header="{Binding [Without profile], Source={x:Static core:Ui.Strings}}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                                            <Image
                                                                Source="{Binding DirectFlag}"
                                                                Width="24"
                                                                Height="18"
                                                                Margin="0,0,8,0">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding DirectFlag}"
                                                                                Value="{x:Null}">
                                                                                <Setter
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <TextBlock
                                                                Text="{Binding Direct}"
                                                                VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn
                                                ClipboardContentBinding="{Binding Profile}"
                                                Width="2*"
                                                Header="{Binding [Through profile], Source={x:Static core:Ui.Strings}}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                                            <Image
                                                                Source="{Binding ProfileFlag}"
                                                                Width="24"
                                                                Height="18"
                                                                Margin="0,0,8,0">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding ProfileFlag}"
                                                                                Value="{x:Null}">
                                                                                <Setter
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <TextBlock
                                                                Text="{Binding Profile}"
                                                                VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Expander
                            x:Name="TestLogExpander"
                            Header="{DynamicResource &quot;Test details&quot;}"
                            HorizontalContentAlignment="Stretch"
                            Margin="0,0,0,12">
                            <TextBox
                                x:Name="TestLogText"
                                local:LogAutoScroll.Enabled="True"
                                Height="200"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                FontFamily="Consolas"
                                FontWeight="Normal"
                                Margin="0,12,0,0"
                                AutomationProperties.Name="{DynamicResource &quot;Connection test details&quot;}" />
                        </Expander>
                        <TextBlock
                            Text="{DynamicResource &quot;External services can see the tested route's IP address.&quot;}"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource &quot;Log&quot;}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button
                            x:Name="ExportLogButton"
                            Content="{DynamicResource &quot;Export log…&quot;}"
                            Click="ExportLogClick"
                            Margin="0,0,16,0" />
                        <TextBlock
                            Text="{DynamicResource &quot;Local rotating log&quot;}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox
                        x:Name="LogText"
                        local:LogAutoScroll.Enabled="True"
                        Grid.Row="1"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        FontWeight="Normal"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        AutomationProperties.Name="{DynamicResource &quot;Diagnostic log&quot;}" />
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="MessageText"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                AutomationProperties.LiveSetting="Polite"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Row="1"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run x:Name="BuildInformationText" />
                <Run Text=" · " />
                <Hyperlink
                    NavigateUri="https://github.com/andre487/WindowsMegaProxy"
                    RequestNavigate="OpenGitHub">GitHub</Hyperlink>
                <Run x:Name="ReadOnlyModeText" />
            </TextBlock>
        </Grid>
    </Grid>
</Window>
