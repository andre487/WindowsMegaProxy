<?xml version="1.0" encoding="utf-8"?>
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WindowsMegaProxy"
    xmlns:core="clr-namespace:WindowsMegaProxy;assembly=WindowsMegaProxy.Core"
    x:Class="WindowsMegaProxy.MainWindow"
    Title="MegaProxy"
    Width="1100"
    Height="740"
    MinWidth="820"
    MinHeight="590"
    Icon="Assets/app.ico"
    FontFamily="Segoe UI Variable, Segoe UI"
    FontSize="14"
    FontWeight="Normal"
    UseLayoutRounding="True"
    Closing="WindowClosing"
    StateChanged="WindowStateChanged"
    Loaded="WindowLoaded"
    SizeChanged="WindowSizeChanged">
    <Window.Resources>
        <Style x:Key="SettingsCategoryStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="DiagnosticCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="DiagnosticValueStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <EventSetter Event="SizeChanged" Handler="TableSizeChanged" />
            <EventSetter Event="Loaded" Handler="TableLoaded" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
            <Setter Property="ClipboardCopyMode" Value="ExcludeHeader" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="CanUserDeleteRows" Value="False" />
        </Style>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="TrafficRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="#04808080" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="CountryFlagStyle" TargetType="Image">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FlagUri}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ProfileTypeBadgeTemplate">
            <Border
                UseLayoutRounding="False"
                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                VerticalAlignment="Center"
                Padding="6,1">
                <TextBlock
                    Text="{Binding TypeLabel}"
                    Style="{x:Null}"
                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ProfilePickerTemplate">
            <Grid MaxWidth="360" Loaded="AlignProfilePickerBaseline" SizeChanged="AlignProfilePickerBaseline">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Background="{Binding ColorHex}"
                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    BorderThickness="1"
                    Width="10"
                    Height="10"
                    CornerRadius="5"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center" />
                <Image
                    Grid.Column="1"
                    Source="{Binding FlagUri}"
                    Style="{StaticResource CountryFlagStyle}"
                    ToolTip="{Binding CountryName}"
                    AutomationProperties.Name="{Binding CountryName}" />
                <TextBlock
                    Grid.Column="2"
                    Style="{x:Null}"
                    Text="{Binding Name}"
                    ToolTip="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <ContentControl
                    Grid.Column="3"
                    FontSize="11"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource ProfileTypeBadgeTemplate}"
                    Margin="8,0,0,0"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <Style x:Key="SectionHeaderStyle" TargetType="TabItem">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border
                                x:Name="HeaderBackground"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Border
                                x:Name="SelectionIndicator"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Height="3"
                                Width="24"
                                CornerRadius="1.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="HeaderBackground"
                                    Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    Property="Foreground"
                                    Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootLayout" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            x:Name="ConnectionCard"
            Grid.Row="1"
            Padding="20,16"
            Margin="0,0,0,16"
            CornerRadius="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock TextWrapping="Wrap">
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <TextBlock
                                x:Name="StatusText"
                                Text="{DynamicResource &quot;Disconnected&quot;}"
                                Style="{DynamicResource SubtitleTextBlockStyle}"
                                Margin="0,4,0,4"
                                AutomationProperties.LiveSetting="Polite" />
                        </InlineUIContainer>
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <TextBlock
                                x:Name="ServiceStateText"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Margin="6,4,0,4"
                                Visibility="Collapsed"
                                AutomationProperties.LiveSetting="Polite" />
                        </InlineUIContainer>
                    </TextBlock>
                    <TextBlock
                        x:Name="RoutingWarningText"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Visibility="Collapsed"
                        Margin="0,4,0,4"
                        AutomationProperties.LiveSetting="Polite" />
                    <ComboBox
                        x:Name="ProfilePicker"
                        VerticalContentAlignment="Center"
                        ItemTemplate="{StaticResource ProfilePickerTemplate}"
                        SelectionChanged="ProfileSelectionChanged"
                        MinWidth="240"
                        MaxWidth="420"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,8"
                        AutomationProperties.Name="{DynamicResource &quot;Active profile&quot;}" />
                    <TextBlock
                        x:Name="ProfileSummary"
                        Text="{DynamicResource &quot;No proxy configured&quot;}"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Width="172" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button
                        x:Name="ConnectButton"
                        Click="ConnectClick"
                        Content="{DynamicResource &quot;Connect&quot;}"
                        Style="{DynamicResource AccentButtonStyle}"
                        MinWidth="120"
                        MinHeight="32"
                        Padding="12,4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="ReconnectButton"
                        HorizontalAlignment="Stretch"
                        Content="{DynamicResource &quot;Reconnect&quot;}"
                        Click="ReconnectClick"
                        Margin="0,8,0,0"
                        IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
        <TabControl
            x:Name="Sections"
            Grid.Row="2"
            ItemContainerStyle="{StaticResource SectionHeaderStyle}"
            AutomationProperties.Name="{DynamicResource &quot;Application sections&quot;}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <UniformGrid Rows="1" IsItemsHost="True" Margin="0,0,0,12" KeyboardNavigation.TabIndex="1" />
                        <Border
                            Grid.Row="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                ContentSource="SelectedContent"
                                Margin="20" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="{DynamicResource &quot;Connections&quot;}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox
                            x:Name="ShowAllConnectionsBox"
                            Content="{DynamicResource &quot;Show all&quot;}"
                            Click="ShowAllConnectionsClick"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0" />
                        <TextBlock x:Name="TrafficText" Text="↑ —  ↓ —" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock
                            x:Name="ConnectionsHint"
                            Text="{DynamicResource &quot;Connect to view traffic. Only rule exceptions are shown by default.&quot;}"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0" />
                    </StackPanel>
                    <DataGrid
                        x:Name="ConnectionsGrid"
                        MinColumnWidth="80"
                        ScrollViewer.CanContentScroll="True"
                        VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        AutomationProperties.Name="{DynamicResource &quot;Active connections&quot;}"
                        EnableRowVirtualization="True">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            Padding="12,6"
                                            Margin="0,8,0,0">
                                            <TextBlock FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style
                                                        TargetType="TextBlock"
                                                        BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter
                                                            Property="Text"
                                                            Value="{DynamicResource &quot;System mode&quot;}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="0">
                                                                <Setter
                                                                    Property="Text"
                                                                    Value="{DynamicResource &quot;Active profile&quot;}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="1">
                                                                <Setter
                                                                    Property="Text"
                                                                    Value="{DynamicResource &quot;Blocked&quot;}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource TrafficRowStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RouteGroup}" Value="0">
                                        <Setter Property="Background" Value="#0C0078D4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RouteGroup}" Value="1">
                                        <Setter Property="Background" Value="#10EAA300" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                ClipboardContentBinding="{Binding Process}"
                                SortMemberPath="Process"
                                Width="4*"
                                MinWidth="160"
                                Header="{Binding [Application], Source={x:Static core:Ui.Strings}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:PathTextBox FullPath="{Binding Process}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Binding="{Binding Destination}"
                                Width="2*"
                                MinWidth="160"
                                Header="{Binding [Destination], Source={x:Static core:Ui.Strings}}" />
                            <DataGridTextColumn
                                Binding="{Binding Network}"
                                Width="SizeToHeader"
                                MinWidth="80"
                                Header="{Binding [Protocol], Source={x:Static core:Ui.Strings}}" />
                            <DataGridTextColumn
                                Binding="{Binding Download}"
                                SortMemberPath="DownloadedBytes"
                                Width="SizeToHeader"
                                MinWidth="80"
                                Header="{Binding [Downloaded], Source={x:Static core:Ui.Strings}}" />
                            <DataGridTextColumn
                                Binding="{Binding Upload}"
                                SortMemberPath="UploadedBytes"
                                Width="SizeToHeader"
                                MinWidth="80"
                                Header="{Binding [Uploaded], Source={x:Static core:Ui.Strings}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource &quot;Profiles&quot;}">
                <Grid x:Name="ProfilePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox
                        x:Name="ProfilesList"
                        AllowDrop="True"
                        PreviewMouseLeftButtonDown="ProfileDragDown"
                        PreviewMouseMove="ProfileDragMove"
                        DragOver="ProfileDragOver"
                        DragLeave="ProfileDragLeave"
                        Drop="ProfileDrop"
                        SelectionChanged="ListSelectionChanged"
                        Grid.Row="1"
                        AutomationProperties.Name="{DynamicResource &quot;Connection profiles&quot;}"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Background="{Binding ColorHex}"
                                        CornerRadius="2"
                                        BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                        BorderThickness="0.5" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <DockPanel>
                                            <ContentControl
                                                DockPanel.Dock="Right"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource ProfileTypeBadgeTemplate}"
                                                VerticalContentAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0" />
                                            <Image
                                                Source="{Binding FlagUri}"
                                                Style="{StaticResource CountryFlagStyle}"
                                                ToolTip="{Binding CountryName}"
                                                AutomationProperties.Name="{Binding CountryName}" />
                                            <TextBlock
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding Name}" />
                                        </DockPanel>
                                        <TextBlock
                                            Text="{Binding Endpoint}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Description}"
                                            Margin="0,4,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{Binding Availability}"
                                            TextWrapping="Wrap"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button
                            Content="{DynamicResource &quot;Add&quot;}"
                            Click="AddProfileClick"
                            Margin="0,0,8,8" />
                        <Button
                            Content="{DynamicResource &quot;Edit&quot;}"
                            x:Name="EditProfileButton"
                            Click="EditProfileClick"
                            Margin="0,0,8,8" />
                        <Button
                            Content="{DynamicResource &quot;Duplicate&quot;}"
                            x:Name="CloneProfileButton"
                            Click="CloneProfileClick"
                            Margin="0,0,8,8" />
                        <Button
                            Content="{DynamicResource &quot;Delete&quot;}"
                            x:Name="DeleteProfileButton"
                            Click="DeleteProfileClick"
                            Margin="0,0,8,8" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,8">
                            <Hyperlink x:Name="ProfileTransferLink" Click="OpenTransferSettingsClick">
                                <Run Text="{DynamicResource &quot;Import and export configuration&quot;}" />
                            </Hyperlink>
                        </TextBlock>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource &quot;Rules&quot;}">
                <Grid x:Name="RulesPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock
                            Text="{DynamicResource &quot;Default action:&quot;}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                        <ComboBox
                            x:Name="DefaultActionBox"
                            MinWidth="200"
                            AutomationProperties.Name="{DynamicResource &quot;Default action&quot;}"
                            SelectedIndex="0">
                            <ComboBoxItem Content="{DynamicResource &quot;Active profile&quot;}" Tag="proxy" />
                            <ComboBoxItem Content="{DynamicResource &quot;System mode&quot;}" Tag="system" />
                            <ComboBoxItem Content="{DynamicResource &quot;Block&quot;}" Tag="block" />
                        </ComboBox>
                        <CheckBox
                            x:Name="BypassLanBox"
                            Content="{DynamicResource &quot;Bypass local networks&quot;}"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Text="{DynamicResource &quot;Rules run from top to bottom; the first match selects the route. LAN bypass follows the list. Reconnect to apply changes.&quot;}"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12" />
                    <DataGrid
                        x:Name="RulesList"
                        SelectionChanged="ListSelectionChanged"
                        MouseDoubleClick="RulesDoubleClick"
                        PreviewKeyDown="RulesKeyDown"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        SelectionUnit="FullRow"
                        AutomationProperties.Name="{DynamicResource &quot;Routing rules in priority order&quot;}"
                        CanUserSortColumns="False"
                        Grid.Row="2"
                        RowStyle="{StaticResource TrafficRowStyle}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Width="Auto"
                                ClipboardContentBinding="{Binding Enabled}"
                                Header="{Binding [Enabled], Source={x:Static core:Ui.Strings}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            IsChecked="{Binding Enabled, Mode=OneWay}"
                                            IsEnabled="{Binding RulesEditable, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            AutomationProperties.Name="{Binding NameLabel}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="RuleEnabledClick" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding NameLabel}"
                                Header="{Binding [Name], Source={x:Static core:Ui.Strings}}" />
                            <DataGridTemplateColumn
                                Width="2*"
                                ClipboardContentBinding="{Binding SourceLabel}"
                                Header="{Binding [Application], Source={x:Static core:Ui.Strings}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:PathTextBox FullPath="{Binding SourceLabel}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding DestinationLabel}"
                                Header="{Binding [Destination], Source={x:Static core:Ui.Strings}}" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ActionLabel}"
                                Header="{Binding [Action], Source={x:Static core:Ui.Strings}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button
                            Content="{DynamicResource &quot;Add&quot;}"
                            Margin="0,0,8,0"
                            Click="AddRuleClick" />
                        <Button
                            Content="{DynamicResource &quot;Edit&quot;}"
                            Margin="0,0,8,0"
                            x:Name="EditRuleButton"
                            Click="EditRuleClick" />
                        <Button
                            Content="{DynamicResource &quot;Delete&quot;}"
                            Margin="0,0,8,0"
                            x:Name="DeleteRuleButton"
                            Click="DeleteRuleClick" />
                        <Button
                            Content="↑"
                            AutomationProperties.Name="{DynamicResource &quot;Move rule up&quot;}"
                            Margin="0,0,8,0"
                            x:Name="MoveRuleUpButton"
                            Click="MoveRuleUpClick" />
                        <Button
                            Content="↓"
                            AutomationProperties.Name="{DynamicResource &quot;Move rule down&quot;}"
                            Margin="0,0,8,0"
                            x:Name="MoveRuleDownButton"
                            Click="MoveRuleDownClick" />
                        <Button
                            x:Name="UndoDeleteRuleButton"
                            Content="{DynamicResource &quot;Undo delete&quot;}"
                            Click="UndoDeleteRuleClick"
                            Margin="8,0,0,0"
                            Visibility="Collapsed" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem
                x:Name="SettingsTab"
                Header="{DynamicResource &quot;Settings&quot;}"
                PreviewKeyDown="SettingsNavigationKeyDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel
                        Margin="0,0,0,20"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="SettingsBackButton"
                            Content="&#xE72B;"
                            FontFamily="Segoe MDL2 Assets"
