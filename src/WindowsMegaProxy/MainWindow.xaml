                                            x:Name="UpdateStatusText"
                                            TextWrapping="Wrap"
                                            AutomationProperties.LiveSetting="Polite"
                                            Margin="0,0,0,8" />
                                        <TextBlock
                                            x:Name="UpdateVersionText"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Visibility="Collapsed"
                                            Margin="0,0,0,12" />
                                        <WrapPanel>
                                            <Button
                                                x:Name="DownloadUpdateButton"
                                                Content="{DynamicResource &quot;Download update&quot;}"
                                                Visibility="Collapsed"
                                                MinWidth="160"
                                                Margin="0,0,8,12"
                                                Click="DownloadUpdateClick" />
                                            <Button
                                                x:Name="InstallUpdateButton"
                                                Content="{DynamicResource &quot;Install update&quot;}"
                                                Visibility="Collapsed"
                                                MinWidth="160"
                                                Margin="0,0,8,12"
                                                Click="InstallUpdateClick" />
                                            <Button
                                                x:Name="CheckUpdatesButton"
                                                Content="{DynamicResource &quot;Check now&quot;}"
                                                MinWidth="140"
                                                Margin="0,0,0,12"
                                                Click="CheckUpdatesClick" />
                                        </WrapPanel>
                                        <TextBlock
                                            x:Name="UpdateReleaseLinkText"
                                            Visibility="Collapsed"
                                            Margin="0,0,0,12">
                                            <Hyperlink
                                                x:Name="UpdateReleaseLink"
                                                RequestNavigate="OpenGitHub">
                                                <Run Text="{DynamicResource &quot;View changelog on GitHub&quot;}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <ProgressBar
                                            x:Name="UpdateDownloadProgress"
                                            Minimum="0"
                                            Maximum="100"
                                            Height="4"
                                            Visibility="Collapsed"
                                            Margin="0,0,0,12"
                                            AutomationProperties.Name="{DynamicResource &quot;Update download progress&quot;}" />
                                        <TextBlock
                                            x:Name="UpdateErrorText"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed"
                                            Margin="0,0,0,12" />
                                        <CheckBox
                                            x:Name="UpdatesThroughProxyBox"
                                            Content="{DynamicResource &quot;Download updates through proxy&quot;}"
                                            Click="AutomaticUpdatesChanged"
                                            Margin="0,8,0,8" />
                                        <CheckBox
                                            x:Name="AutomaticUpdatesBox"
                                            Content="{DynamicResource &quot;Automatically check for updates&quot;}"
                                            Click="AutomaticUpdatesChanged"
                                            Margin="0,8,0,8" />
                                        <TextBlock
                                            Text="{DynamicResource &quot;Checks once a day. Ignored notifications repeat after a week or when a new release is available.&quot;}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="DiagnosticsTab" Header="{DynamicResource &quot;Diagnostics&quot;}">
                <ScrollViewer
                    x:Name="DiagnosticsScroll"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="DiagnosticResultCard" Style="{StaticResource DiagnosticCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{DynamicResource &quot;Connection&quot;}"
                                            Style="{DynamicResource SubtitleTextBlockStyle}" />
                                        <TextBlock
                                            x:Name="TestStatusText"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                            Text="{DynamicResource &quot;Ready to test&quot;}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Margin="0,4,0,0"
                                            AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <Button
                                        x:Name="TestConnectionButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource &quot;Run again&quot;}"
                                        Click="TestConnectionClick"
                                        MinWidth="120"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar
                                    x:Name="TestProgress"
                                    IsIndeterminate="True"
                                    Visibility="Collapsed"
                                    Height="4"
                                    Margin="0,0,0,12" />
                                <TextBlock
                                    x:Name="TestResultText"
                                    TextWrapping="Wrap"
                                    Text="{DynamicResource &quot;Testing starts automatically when this tab opens.&quot;}"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid x:Name="DiagnosticDetailsPanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Text="{DynamicResource &quot;Public IP&quot;}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,8" />
                                    <TextBox
                                        x:Name="DiagnosticIpText"
                                        Grid.Column="1"
                                        Style="{StaticResource DiagnosticValueStyle}"
                                        Margin="0,0,0,8"
                                        AutomationProperties.Name="{DynamicResource &quot;Public IP&quot;}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{DynamicResource &quot;Country&quot;}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,8" />
                                    <StackPanel
                                        x:Name="DiagnosticCountryPanel"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,8">
                                        <Image
                                            Source="{Binding FlagUri}"
                                            Style="{StaticResource CountryFlagStyle}"
                                            AutomationProperties.Name="{Binding Label}" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="{DynamicResource &quot;Check time&quot;}"
                                        ToolTip="{DynamicResource &quot;HTTPS request duration, including connection establishment when needed, TLS and reading the response body. This is not network RTT.&quot;}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Margin="0,0,16,8" />
                                    <TextBlock
                                        x:Name="DiagnosticLatencyText"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,0,0,8" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Text="{DynamicResource &quot;IP reputation (ProxyCheck)&quot;}"
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Margin="0,8,16,0" />
                                    <TextBlock
                                        x:Name="DiagnosticReputationText"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        TextWrapping="Wrap"
                                        Margin="0,8,0,0" />
                                    <TextBlock
                                        x:Name="DiagnosticHttp3Label"
                                        Grid.Row="3"
                                        Text="HTTP/3"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Margin="0,0,16,0" />
                                    <TextBlock
                                        x:Name="DiagnosticHttp3Text"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DiagnosticSpeedCard" Style="{StaticResource DiagnosticCardStyle}">
                            <StackPanel>
                                <TextBlock
                                    Text="{DynamicResource &quot;Transfer speed&quot;}"
                                    Style="{DynamicResource SubtitleTextBlockStyle}"
                                    Margin="0,0,0,12" />
                                <TextBlock
                                    x:Name="SpeedLockedText"
                                    Text="{DynamicResource &quot;Complete a successful connection test first.&quot;}"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="SpeedPanel" Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="SpeedTrafficText"
                                        Text="{DynamicResource &quot;Cloudflare: 10 MB download and upload per route, up to 40 MB of traffic.&quot;}"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel x:Name="SpeedOptionsPanel">
                                            <StackPanel Width="144" Margin="0,0,16,12">
                                                <Label
                                                    Content="{DynamicResource &quot;Size per route&quot;}"
                                                    Target="{Binding ElementName=SpeedSizeBox}"
                                                    Padding="0"
                                                    Margin="0,0,0,4" />
                                                <ComboBox
                                                    x:Name="SpeedSizeBox"
                                                    SelectedIndex="0"
                                                    SelectionChanged="SpeedSizeChanged"
                                                    HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="{DynamicResource &quot;Speed test size&quot;}">
                                                    <ComboBoxItem
                                                        Content="{DynamicResource &quot;10 MB&quot;}"
                                                        Tag="10" />
                                                    <ComboBoxItem
                                                        Content="{DynamicResource &quot;25 MB&quot;}"
                                                        Tag="25" />
                                                    <ComboBoxItem
                                                        Content="{DynamicResource &quot;50 MB&quot;}"
                                                        Tag="50" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Width="144" Margin="0,0,16,12">
                                                <Label
                                                    Content="{DynamicResource &quot;HTTP preference&quot;}"
                                                    Target="{Binding ElementName=SpeedProtocolBox}"
                                                    Padding="0"
                                                    Margin="0,0,0,4" />
                                                <ComboBox
                                                    x:Name="SpeedProtocolBox"
                                                    SelectedIndex="1"
                                                    HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="{DynamicResource &quot;Preferred speed test protocol&quot;}">
                                                    <ComboBoxItem Content="HTTP/3" Tag="h3" />
                                                    <ComboBoxItem Content="HTTP/2" Tag="h2" />
                                                    <ComboBoxItem Content="HTTP/1.1" Tag="h1" />
                                                </ComboBox>
                                            </StackPanel>
                                        </WrapPanel>
                                        <Button
                                            x:Name="SpeedTestButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource &quot;Test speed&quot;}"
                                            Click="SpeedTestClick"
                                            MinWidth="144"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,12" />
                                    </Grid>
                                    <DataGrid
                                        x:Name="SpeedResultsGrid"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        IsReadOnly="True"
                                        Height="240"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="{DynamicResource &quot;Route speed comparison&quot;}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Binding="{Binding Metric}"
                                                Width="*"
                                                Header="{Binding [Metric], Source={x:Static core:Ui.Strings}}" />
                                            <DataGridTemplateColumn
                                                ClipboardContentBinding="{Binding Direct}"
                                                Width="2*"
                                                Header="{Binding [Without profile], Source={x:Static core:Ui.Strings}}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                                            <Image
                                                                Source="{Binding DirectFlag}"
                                                                Width="24"
                                                                Height="18"
                                                                Margin="0,0,8,0">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding DirectFlag}"
                                                                                Value="{x:Null}">
                                                                                <Setter
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <TextBlock
                                                                Text="{Binding Direct}"
                                                                VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn
                                                ClipboardContentBinding="{Binding Profile}"
                                                Width="2*"
                                                Header="{Binding [Through profile], Source={x:Static core:Ui.Strings}}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                                            <Image
                                                                Source="{Binding ProfileFlag}"
                                                                Width="24"
                                                                Height="18"
                                                                Margin="0,0,8,0">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding ProfileFlag}"
                                                                                Value="{x:Null}">
                                                                                <Setter
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <TextBlock
                                                                Text="{Binding Profile}"
                                                                VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Expander
                            x:Name="TestLogExpander"
                            Header="{DynamicResource &quot;Test details&quot;}"
                            HorizontalContentAlignment="Stretch"
                            Margin="0,0,0,12">
                            <TextBox
                                x:Name="TestLogText"
                                local:LogAutoScroll.Enabled="True"
                                Height="200"
                                IsReadOnly="True"
                                IsReadOnlyCaretVisible="True"
                                IsInactiveSelectionHighlightEnabled="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                FontFamily="Consolas"
                                FontWeight="Normal"
                                Margin="0,12,0,0"
                                AutomationProperties.Name="{DynamicResource &quot;Connection test details&quot;}" />
                        </Expander>
                        <TextBlock
                            Text="{DynamicResource &quot;External services can see the tested route's IP address.&quot;}"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource &quot;Log&quot;}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button
                            x:Name="ExportLogButton"
                            Content="{DynamicResource &quot;Export log…&quot;}"
                            Click="ExportLogClick"
                            Margin="0,0,16,0" />
                        <TextBlock
                            Text="{DynamicResource &quot;Local rotating log&quot;}"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox
                        x:Name="LogText"
                        local:LogAutoScroll.Enabled="True"
                        Grid.Row="1"
                        IsReadOnly="True"
                        IsReadOnlyCaretVisible="True"
                        IsInactiveSelectionHighlightEnabled="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        FontWeight="Normal"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        AutomationProperties.Name="{DynamicResource &quot;Diagnostic log&quot;}" />
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="MessageText"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                AutomationProperties.LiveSetting="Polite"
                VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run x:Name="BuildInformationText" />
                <Run Text=" · " />
                <Hyperlink
                    NavigateUri="https://github.com/andre487/WindowsMegaProxy"
                    RequestNavigate="OpenGitHub">GitHub</Hyperlink>
                <Run x:Name="ReadOnlyModeText" />
            </TextBlock>
        </Grid>
    </Grid>
</Window>
