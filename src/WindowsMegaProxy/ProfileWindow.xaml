<?xml version="1.0" encoding="utf-8"?>
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WindowsMegaProxy"
    x:Class="WindowsMegaProxy.ProfileWindow"
    Title="{DynamicResource &quot;Connection profile&quot;}"
    Width="540"
    MinWidth="500"
    Height="590"
    MinHeight="450"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    FontFamily="Segoe UI Variable, Segoe UI"
    FontWeight="Normal"
    FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Label
                    Content="{DynamicResource &quot;Name&quot;}"
                    Target="{Binding ElementName=NameBox}"
                    Padding="0"
                    Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" Margin="0,0,0,16" />
                <StackPanel x:Name="ConnectionFields">
                    <Label
                        Content="{DynamicResource &quot;Server type&quot;}"
                        Target="{Binding ElementName=TypeBox}"
                        Padding="0"
                        Margin="0,0,0,4" />
                    <ComboBox x:Name="TypeBox" SelectionChanged="TypeChanged" Margin="0,0,0,16">
                        <ComboBoxItem Content="HTTPS" Tag="HTTPS" />
                        <ComboBoxItem Content="{DynamicResource &quot;HTTPS with Jump&quot;}" Tag="HTTPS_JUMP" />
                        <ComboBoxItem Content="SOCKS5" Tag="SOCKS5" />
                        <ComboBoxItem Content="SSH" Tag="SSH" />
                        <ComboBoxItem Content="{DynamicResource &quot;SSH with Jump&quot;}" Tag="SSH_JUMP" />
                        <ComboBoxItem Content="MASQUE α (HTTP/3)" Tag="MASQUE" />
                    </ComboBox>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <Label
                                Content="{DynamicResource &quot;Server&quot;}"
                                Target="{Binding ElementName=HostBox}"
                                Padding="0"
                                Margin="0,0,0,4" />
                            <TextBox x:Name="HostBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Label
                                Content="{DynamicResource &quot;Port&quot;}"
                                Target="{Binding ElementName=PortBox}"
                                Padding="0"
                                Margin="0,0,0,4" />
                            <TextBox x:Name="PortBox" />
                        </StackPanel>
                    </Grid>
                    <Label
                        Content="{DynamicResource &quot;Username&quot;}"
                        Target="{Binding ElementName=UsernameBox}"
                        Padding="0"
                        Margin="0,0,0,4" />
                    <TextBox x:Name="UsernameBox" Margin="0,0,0,16" />
                    <Label
                        Content="{DynamicResource &quot;Password&quot;}"
                        Target="{Binding ElementName=PasswordBox}"
                        Padding="0"
                        Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,16" />
                    <StackPanel x:Name="HttpVersionPanel" Margin="0,0,0,8">
                        <Label
                            Content="{DynamicResource &quot;Proxy HTTP support&quot;}"
                            Target="{Binding ElementName=HttpVersionBox}"
                            Padding="0"
                            Margin="0,0,0,4" />
                        <ComboBox x:Name="HttpVersionBox" SelectedIndex="0">
                            <ComboBoxItem Content="{DynamicResource &quot;Stable core (HTTP/1.1)&quot;}" />
                            <ComboBoxItem Content="{DynamicResource &quot;Enable HTTP/2 (1.15 alpha)&quot;}" />
                            <ComboBoxItem Content="{DynamicResource &quot;Enable HTTP/2 + HTTP/3 (1.15 alpha)&quot;}" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock
                        x:Name="Http3HelpText"
                        Text="{DynamicResource &quot;HTTP/2 and HTTP/3 use the alpha core. HTTPS falls back to a lower HTTP version when unsupported. HTTP/3 requires UDP; MASQUE requires HTTP/3.&quot;}"
                        Style="{x:Static local:UiTheme.ExplanationStyle}"
                        Margin="0,0,0,16" />
                    <StackPanel x:Name="JumpFields">
                        <Label
                            Content="{DynamicResource &quot;Jump server&quot;}"
                            Target="{Binding ElementName=JumpHostBox}"
                            Padding="0"
                            Margin="0,0,0,4" />
                        <TextBox x:Name="JumpHostBox" Margin="0,0,0,12" />
                        <Label
                            Content="{DynamicResource &quot;Jump port&quot;}"
                            Target="{Binding ElementName=JumpPortBox}"
                            Padding="0"
                            Margin="0,0,0,4" />
                        <TextBox x:Name="JumpPortBox" Margin="0,0,0,12" />
                        <CheckBox
                            x:Name="SameJumpAuthenticationBox"
                            Content="{DynamicResource &quot;Use the same credentials for both proxies&quot;}"
                            Click="SameJumpAuthenticationChanged"
                            Margin="0,0,0,12" />
                        <StackPanel x:Name="JumpCredentials">
                            <Label
                                Content="{DynamicResource &quot;Jump username&quot;}"
                                Target="{Binding ElementName=JumpUsernameBox}"
                                Padding="0"
                                Margin="0,0,0,4" />
                            <TextBox x:Name="JumpUsernameBox" Margin="0,0,0,12" />
                            <Label
                                Content="{DynamicResource &quot;Jump password&quot;}"
                                Target="{Binding ElementName=JumpPasswordBox}"
                                Padding="0"
                                Margin="0,0,0,4" />
                            <PasswordBox x:Name="JumpPasswordBox" Margin="0,0,0,12" />
                            <StackPanel x:Name="JumpPrivateKeyPanel">
                                <Label
                                    Content="{DynamicResource &quot;Jump private key&quot;}"
                                    Target="{Binding ElementName=JumpPrivateKeyBox}"
                                    Padding="0"
                                    Margin="0,0,0,4" />
                                <TextBox
                                    x:Name="JumpPrivateKeyBox"
                                    AcceptsReturn="True"
                                    Height="100"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"
                                    FontFamily="Consolas"
                                    Margin="0,0,0,12" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox
                            x:Name="JumpInvalidCertificateBox"
                            Content="{DynamicResource &quot;Allow an invalid jump certificate&quot;}"
                            Margin="0,0,0,16" />
                    </StackPanel>
                    <StackPanel x:Name="SshFields">
                        <Label
                            Content="{DynamicResource &quot;SSH fingerprint&quot;}"
                            Target="{Binding ElementName=SshProfileBox}"
                            Padding="0"
                            Margin="0,0,0,4" />
                        <ComboBox x:Name="SshProfileBox" Margin="0,0,0,16">
                            <ComboBoxItem Content="OpenSSH / Termux (default)" Tag="DEFAULT" />
                            <ComboBoxItem Content="OpenSSH / Termux" Tag="OPENSSH_TERMUX" />
                            <ComboBoxItem Content="ConnectBot" Tag="CONNECTBOT" />
                            <ComboBoxItem Content="JuiceSSH" Tag="JUICESSH" />
                            <ComboBoxItem Content="Termius" Tag="TERMIUS_ANDROID" />
                        </ComboBox>
                        <Label
                            Content="{DynamicResource &quot;Private key (optional, unencrypted OpenSSH or PEM)&quot;}"
                            Target="{Binding ElementName=PrivateKeyBox}"
                            Padding="0"
                            Margin="0,0,0,4" />
                        <TextBox
                            x:Name="PrivateKeyBox"
                            AcceptsReturn="True"
                            Height="100"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            FontFamily="Consolas" />
                        <Button
                            Content="{DynamicResource &quot;Load private key…&quot;}"
                            Click="LoadPrivateKeyClick"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,16" />
                    </StackPanel>
                    <CheckBox
                        x:Name="InvalidCertificateBox"
                        Content="{DynamicResource &quot;Allow an invalid proxy certificate&quot;}"
                        Margin="0,0,0,16" />
                </StackPanel>
                <StackPanel x:Name="AuthProbeHostPanel" Margin="0,0,0,16">
                    <Label
                        Content="{DynamicResource &quot;Authentication check host (knock host)&quot;}"
                        Target="{Binding ElementName=AuthProbeHostBox}"
                        Padding="0"
                        Margin="0,0,0,4" />
                    <TextBox x:Name="AuthProbeHostBox" />
                    <TextBlock
                        Text="{DynamicResource &quot;Optional. For HTTPS: the server's knock host reveals masked authentication failures.&quot;}"
                        TextWrapping="Wrap"
                        Style="{x:Static local:UiTheme.ExplanationStyle}"
                        Margin="0,4,0,0" />
                </StackPanel>
                <CheckBox
                    x:Name="AllowIpv6Box"
                    Content="{DynamicResource &quot;Allow IPv6 destinations through this profile&quot;}"
                    Margin="0,0,0,16" />
                <Expander Header="DNS" Margin="0,0,0,16">
                    <StackPanel Margin="0,12,0,0">
                        <Label
                            Content="{DynamicResource &quot;DNS provider&quot;}"
                            Target="{Binding ElementName=DnsProviderBox}"
                            Padding="0"
                            Margin="0,0,0,4" />
                        <ComboBox x:Name="DnsProviderBox" SelectionChanged="DnsProviderChanged" />
                        <StackPanel x:Name="DnsUrlPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <Label
                                Content="{DynamicResource &quot;Custom DNS URL&quot;}"
                                Target="{Binding ElementName=DnsUrlBox}"
                                Padding="0"
                                Margin="0,0,0,4" />
                            <TextBox x:Name="DnsUrlBox" />
                            <TextBlock
                                Text="{DynamicResource &quot;HTTPS DoH, or tcp://IP:53 / udp://IP:53. Plain DNS uses the proxy and is unencrypted after the proxy.&quot;}"
                                TextWrapping="Wrap"
                                Style="{x:Static local:UiTheme.ExplanationStyle}"
                                Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock
                            Text="{DynamicResource &quot;Used through the active proxy when the default route is the active profile. System mode keeps Windows DNS. Apps using their own encrypted DNS are not redirected.&quot;}"
                            TextWrapping="Wrap"
                            Style="{x:Static local:UiTheme.ExplanationStyle}"
                            Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>
                <Expander Header="{DynamicResource &quot;Appearance&quot;}" Margin="0,0,0,16">
                    <StackPanel Margin="0,12,0,0">
                        <Label
                            Content="{DynamicResource &quot;Profile country&quot;}"
                            Target="{Binding ElementName=CountryBox}"
                            Padding="0"
                            Margin="0,0,0,4" />
                        <ComboBox
                            x:Name="CountryBox"
                            SelectionChanged="CountryChanged"
                            TextSearch.TextPath="Name"
                            Margin="0,0,0,16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding FlagUri}" Width="24" Height="18" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Label
                            Content="{DynamicResource &quot;Profile color&quot;}"
                            Target="{Binding ElementName=ColorBox}"
                            Padding="0"
                            Margin="0,0,0,4" />
                        <ComboBox x:Name="ColorBox" SelectionChanged="ColorChanged" Margin="0,0,0,16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border
                                            Background="{Binding Hex}"
                                            Width="14"
                                            Height="14"
                                            CornerRadius="7"
                                            Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                            BorderThickness="1" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Expander>
                <TextBlock
                    x:Name="SupportText"
                    TextWrapping="Wrap"
                    Style="{x:Static local:UiTheme.ExplanationStyle}" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock
            x:Name="ErrorText"
            Grid.Row="1"
            TextWrapping="Wrap"
            Margin="0,12,0,0"
            AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button
                Content="{DynamicResource &quot;Save&quot;}"
                Click="SaveClick"
                IsDefault="True"
                Margin="0,0,8,0" />
            <Button Content="{DynamicResource &quot;Cancel&quot;}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
