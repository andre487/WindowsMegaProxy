<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net462</TargetFramework>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeFrameworkVersion />
        <OutputType>WinExe</OutputType>
        <AssemblyTitle>MegaProxy</AssemblyTitle>
        <Description>MegaProxy installation</Description>
        <ApplicationIcon>../WindowsMegaProxy/Assets/app.ico</ApplicationIcon>
        <MegaProxyDev>false</MegaProxyDev>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="WindowsMegaProxy.SetupChecks" />
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="all" />
        <Reference Include="System.Web.Extensions" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.IO.Compression" />
        <Reference Include="System.IO.Compression.FileSystem" />
        <Reference Include="System.ServiceProcess" />
        <Reference Include="Microsoft.CSharp" />
    </ItemGroup>
    <ItemGroup Condition="'$(InstallerResources)' != ''">
        <EmbeddedResource Include="$(InstallerResources)/setup.json" LogicalName="setup.json" />
    </ItemGroup>
</Project>
